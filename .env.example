# ===== 数据库 =====
POSTGRES_USER=flash
# 必填，务必使用高强度随机值（生成：python -c "import secrets; print(secrets.token_urlsafe(32))"）
# 数据库端口仅绑定 127.0.0.1，公网不可达
POSTGRES_PASSWORD=
POSTGRES_DB=flash

# 应用数据库连接（本地开发用；docker compose 内会自动覆盖为 db 主机名）
# 密码部分必须与 POSTGRES_PASSWORD 一致
DATABASE_URL=postgresql://flash:请填密码@localhost:5432/flash

# ===== Web 管理面认证（必填，fail-closed：未配置则管理接口整体禁用）=====
# 浏览器首次访问会要求输入该令牌
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# HTTPS 部署时置 true 启用 HSTS（本地 http 不要开）
ENABLE_HSTS=false

# 允许 LLM/Embedding 地址指向私网/回环（本地自建网关如 Ollama 时置 true）
ALLOW_PRIVATE_BASE_URL=false

# API 宿主编口（docker compose 映射用；容器内部恒为 8000）
API_PORT=8001

# MCP Server 宿主编口（容器内部恒为 8001）
MCP_PORT=8002

# Agent 调用日志保留天数（超期自动清理）
AGENT_LOG_RETENTION_DAYS=90

# ===== LLM（AI 结构化）=====
# 兼容 OpenAI Chat Completions 接口的任何服务均可
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ===== Embedding =====
# 兼容 OpenAI Embeddings 接口的任何服务均可；维度变更需同步重建 embedding 列
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
